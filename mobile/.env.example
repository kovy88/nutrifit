EXPO_PUBLIC_API_BASE_URL=https://nutri-fit-omega.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://gjkbtpfpgigifapjpaci.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_key

# Strava OAuth — register an app at https://www.strava.com/settings/api
# Authorization Callback Domain = nutri-fit-omega.vercel.app
# CLIENT_SECRET stays on Vercel (STRAVA_CLIENT_SECRET env var); only the
# numeric CLIENT_ID is safe to embed in the mobile bundle.
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Whoop OAuth — register an app at https://developer.whoop.com/
# Redirect URL = https://nutri-fit-omega.vercel.app/whoop-callback.html
# Set WHOOP_CLIENT_SECRET on Vercel; only the CLIENT_ID belongs here.
EXPO_PUBLIC_WHOOP_CLIENT_ID=

# Garmin Connect OAuth — apply at https://developerportal.garmin.com/
# Redirect URL = https://nutri-fit-omega.vercel.app/garmin-callback.html
# Garmin Connect Developer Program requires partner approval (~2 weeks).
# Set GARMIN_CLIENT_SECRET on Vercel.
EXPO_PUBLIC_GARMIN_CLIENT_ID=

# Oura Ring OAuth — register at https://cloud.ouraring.com/oauth/applications
# Redirect URL = https://nutri-fit-omega.vercel.app/oura-callback.html
# Scopes: email personal daily heartrate workout tag session spo2 ring_configuration
# Set OURA_CLIENT_SECRET on Vercel.
EXPO_PUBLIC_OURA_CLIENT_ID=

# RevenueCat — configure products (trenr_premium_monthly / trenr_premium_yearly)
# + a "premium" entitlement in the RevenueCat dashboard. Without these keys the
# app falls back to a local Mock subscription provider (dev/Expo Go only —
# see src/lib/subscription/factory.ts).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
