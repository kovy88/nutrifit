{
  "expo": {
    "name": "NutriFit",
    "slug": "nutrifit",
    "scheme": "nutrifit",
    "version": "0.1.0",
    "description": "Česká aplikace pro orientační výpočet maker, plánování jídelníčku a zápis jídla ručně nebo z fotky.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cz.nutrifit.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "NutriFit používá knihovnu fotek jen pro výběr fotografie jídla k odhadu nutričních hodnot.",
        "NSCameraUsageDescription": "NutriFit může použít fotoaparát jen pro vyfocení jídla k orientačnímu odhadu nutričních hodnot."
      }
    },
    "android": {
      "package": "cz.nutrifit.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7f7f4"
      },
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriFit používá knihovnu fotek jen pro výběr fotografie jídla k odhadu nutričních hodnot."
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#f7f7f4"
        }
      ]
    ],
    "extra": {
      "privacyUrl": "https://nutri-fit-omega.vercel.app/legal.html#privacy",
      "supportUrl": "mailto:koval.macek@gmail.com?subject=NutriFit%20podpora",
      "deletionUrl": "https://nutri-fit-omega.vercel.app/delete-account.html"
    }
  }
}
